# HustleX Backend Environment Variables
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/hustlex

# JWT Secret (generate a secure one using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_secure_jwt_secret_here

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Redis (optional - disable for development if not using)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
QUEUE_ENABLED=false
MESSAGE_ASYNC=false

# Email (optional - disable if not using)
EMAIL_ENABLED=false
EMAIL_PROVIDER=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@hustlex.com
ADMIN_EMAIL=hustlexet@gmail.com

# AWS S3 (optional - for file uploads)
S3_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=hustlex-uploads
AWS_REGION=us-east-1

# Telegram (single-bot architecture — see note below)
# ─────────────────────────────────────────────────────────────────────────────
# The Node.js backend owns the HustleXet Telegram bot. It serves the "Welcome
# to the Arena, Champion!" epic copy, Application / Profile / Setting / About
# menus, and login confirmations via a webhook (backend/routes/auth.js).
#
# ⚠️  Do NOT run any other Telegram client (python-telegram-bot long-polling,
#     aiogram polling, BotFather desktop preview, a second webhook on another
#     host) with the SAME bot token. Telegram delivers each update to only one
#     target at a time — a poller will silently starve the webhook.
#
# The legacy telegram_profile_bot.py has been renamed to .legacy.py and now
# exits immediately with a warning if executed. Do not undo that unless you
# also retire the Node handler.
# ─────────────────────────────────────────────────────────────────────────────

# Primary bot token from @BotFather (the one users message as @HustleXet_bot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional explicit login/arena bot token. Falls back to TELEGRAM_BOT_TOKEN if
# unset. Only set this if you split into multiple bots (rare — most deploys
# leave this empty).
TELEGRAM_LOGIN_BOT_TOKEN=

# Public URL of the backend, e.g. https://hustlex-production.up.railway.app/api/auth/telegram/webhook
# Required — without it the bot will not receive any updates.
TELEGRAM_WEBHOOK_URL=
# Optional explicit override for the login webhook. Falls back to TELEGRAM_WEBHOOK_URL.
TELEGRAM_LOGIN_WEBHOOK_URL=

# Bot username (without @) used to build the Mini App "Apply for this job" link
TELEGRAM_BOT_USERNAME=HustleXet_bot

# Optional named Mini App short name configured in @BotFather.
# Leave empty to open the bot's Main Mini App via https://t.me/<bot>?startapp=...
TELEGRAM_MINI_APP_SHORTNAME=

# Retired. Do not set. Only kept here to warn if you accidentally re-introduce
# the old Python bot on the same token — the backend startup check logs a
# loud warning when this equals TELEGRAM_BOT_TOKEN.
TELEGRAM_PROFILE_BOT_TOKEN=
